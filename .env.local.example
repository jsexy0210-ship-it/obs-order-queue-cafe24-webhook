# .env.local 로 복사해서 사용하세요 (Git에는 올리지 마세요)

# 카페24 웹훅 URL 뒤에 ?token=이값 을 붙여서 등록하면,
# 아무나 /api/webhooks/cafe24 를 호출해서 가짜 주문을 넣는 것을 막을 수 있습니다.
# 임의의 긴 문자열로 아무거나 정하면 됩니다.
CAFE24_WEBHOOK_TOKEN=여기에-임의의-긴-랜덤-문자열을-넣으세요

# 관리자 페이지에 로그인할 수 있는 주계정/부계정입니다.
# 실제 값은 .env.local 또는 운영 서버 환경변수에만 넣고 Git에 커밋하지 마세요.
ADMIN_PRIMARY_ID=주계정-아이디
ADMIN_PRIMARY_PASSWORD=주계정-비밀번호
ADMIN_SECONDARY_ID=부계정-아이디
ADMIN_SECONDARY_PASSWORD=부계정-비밀번호

# 카페24 OAuth 연동 정보입니다. Client Secret과 암호화 키는 외부에 공개하거나 Git에 커밋하지 마세요.
CAFE24_MALL_ID=dhdudals5555
CAFE24_CLIENT_ID=카페24-Client-ID
CAFE24_CLIENT_SECRET=재발급한-카페24-Client-Secret
CAFE24_REDIRECT_URI=https://overlay.mangotcg.com/api/cafe24/oauth/callback
# 현재 개발자센터 권한 설정과 정확히 일치시킵니다.
CAFE24_OAUTH_SCOPES=mall.read_application,mall.write_application,mall.read_category,mall.read_product,mall.write_product,mall.read_collection,mall.read_supply,mall.read_order,mall.read_customer,mall.write_customer,mall.read_promotion,mall.read_mileage,mall.write_mileage
# Base64 인코딩된 32바이트 난수입니다. 토큰을 SQLite에 AES-256-GCM으로 암호화해 저장하는 데 사용합니다.
CAFE24_TOKEN_ENCRYPTION_KEY=Base64-인코딩된-32바이트-난수

# 안전을 위해 기본값은 false입니다. 테스트가 모두 끝나고 운영 반영을 승인한 뒤에만 true로 변경하세요.
# 인증정보가 있어도 이 값이 true가 아니면 실제 적립금 지급·회수는 실행되지 않습니다.
CAFE24_REWARD_LIVE_ENABLED=false
# 카페24 주문일과 결제일이 모두 이 시각 이후일 때만 실지급합니다. UTC ISO 8601 시각으로 설정하세요.
CAFE24_REWARD_START_AT=

# 카페24 자체 구매 적립과 기존 지급 예정분을 확인한 뒤에만 true로 변경하세요.
# GitHub Actions 배포에서는 같은 이름의 Secret으로 전달합니다. 미설정 시 false입니다.
CAFE24_NATIVE_REWARDS_DISABLED=false
